{
  "name": "mmd-shot",
  "version": "1.0.0",
  "description": "MMDモデルを踊らせて、好きなタイミングで写真を撮れるアプリ",
  "main": "src/main.js",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron src/main.js",
    "build": "tsc && vite build && electron-builder",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "build:win": "tsc && vite build && electron-builder --win",
    "tsc": "tsc"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.14.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.5.1",
    "electron-builder": "^24.13.1",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.6"
  },
  "build": {
    "appId": "com.electron.mmd-shot",
    "productName": "MMD Shot",
    "files": [
      "dist/",
      "src/main.js",
      "src/preload.js"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "build"
    },
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "motions",
        "to": "motions",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "audios",
        "to": "audios",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "cameras",
        "to": "cameras",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "stages",
        "to": "stages",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@babylonjs/core": "^9.15.0",
    "babylon-mmd": "^1.2.0"
  }
}
